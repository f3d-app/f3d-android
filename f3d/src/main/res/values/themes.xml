<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.F3D" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Customize your theme here. -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.F3D.OptionsPanel" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/panel_surface_translucent</item>
        <item name="colorSurfaceContainerLow">@color/panel_surface_translucent</item>
        <item name="colorSurfaceContainerHigh">@color/panel_card</item>
    </style>

    <style name="Widget.F3D.Chip.LogFilter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:checkable">true</item>
        <item name="android:checked">true</item>
    </style>

    <style name="Theme.F3D.Console" parent="Theme.Material3.Dark.Dialog">
        <item name="colorPrimary">@color/yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/panel_surface</item>
        <item name="colorSurfaceContainerHigh">@color/panel_card</item>
        <item name="android:windowBackground">@color/console_surface</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>